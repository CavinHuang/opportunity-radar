{
  "name": "opportunity-radar",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.16.0"},
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "mcp:stdio": "node --env-file-if-exists=.env src/mcp-stdio.mjs",
    "catalog:probe": "node scripts/probe-source-catalog.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/service.mjs && node --check public/app.js && node --check public/i18n.js && npm test"
  }
}
