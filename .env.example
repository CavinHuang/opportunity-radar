# Local UI binds to loopback by default. Never expose unauthenticated owner API publicly.
RADAR_HOST=127.0.0.1
RADAR_PORT=4177
RADAR_DB=.data/radar.sqlite
# Set for shared-network / reverse proxy use. The UI requests this on first change.
RADAR_OWNER_TOKEN=
# External Coding Agents use a separate least-privilege bearer token.
RADAR_AGENT_TOKEN=
# Optional token for GitHub read-only evidence verification (never exposed to browser).
GITHUB_TOKEN=
# Comma-separated exact GitHub check-run names required for G1.
RADAR_REQUIRED_CHECKS=test
# Optional trusted public RSS/Atom feeds, comma separated (max 5).
RADAR_FEED_URLS=
# Optional OpenAI-compatible LLM for evidence-grounded candidate analysis.
RADAR_LLM_BASE_URL=
RADAR_LLM_MODEL=
RADAR_LLM_API_KEY=
# Model request deadline, including response body; integer 1000..180000 ms.
RADAR_LLM_TIMEOUT_MS=90000
# Jev uses the OpenRouter decisions protocol, separately from the chat model.
JEV_API_KEY=
# OPENROUTER_API_KEY is also accepted when JEV_API_KEY is absent.
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=~typesafe/jev-latest
JEV_TIMEOUT_MS=15000
